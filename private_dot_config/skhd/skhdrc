# -- Changing Window Focus --

# change window focus within space; j/k cycle a stacked space first, h/l continue to the next display
alt - j : yabai -m window --focus stack.next || yabai -m window --focus south
alt - k : yabai -m window --focus stack.prev || yabai -m window --focus north
alt - h : yabai -m window --focus west || yabai -m display --focus west
alt - l : yabai -m window --focus east || yabai -m display --focus east

#change focus between external displays (left and right)
alt - s: yabai -m display --focus west
alt - g: yabai -m display --focus east

# -- Modifying the Layout --

# rotate layout clockwise
shift + alt - r : yabai -m space --rotate 270

# flip along y-axis
shift + alt - y : yabai -m space --mirror y-axis

# flip along x-axis
shift + alt - x : yabai -m space --mirror x-axis

# toggle window float (the grid only applies once it floats; a tiled window rejects it). The grid sets the size;
# center.sh then places it where Shift+Opt+C would, since apps round the grid's position differently
shift + alt - f : yabai -m window --toggle float; \
    [ "$(yabai -m query --windows --window | jq '."is-floating"')" = true ] && yabai -m window --grid 10:4:1:1:2:8 && \
    sh ~/.config/yabai/center.sh

# Toggle Space Float/BSP
ctrl + cmd - f : yabai -m space --layout $(yabai -m query --spaces --space | jq -r 'if .type == "bsp" then "float" else "bsp" end')

# maximize a window, a floating one too (the next press restores it)
shift + alt - m : sh ~/.config/yabai/maximize.sh

# balance out tree of windows (resize to occupy same area)
shift + alt - e : yabai -m space --balance

# Center floating window on screen (maintains size; floats a tiled window first)
shift + alt - c : sh ~/.config/yabai/center.sh

# Cycle layout: bsp → stack → bsp -- T for Toggle
shift + alt - t : yabai -m space --layout $(yabai -m query --spaces --space | jq -r \
    'if .type == "bsp" then "stack" elif .type == "stack" then "bsp" else "bsp" end')


# -- Moving Windows Around --

# swap windows
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - h : yabai -m window --swap west
shift + alt - l : yabai -m window --swap east

# move window and split
shift + cmd - j : yabai -m window --warp south
shift + cmd - k : yabai -m window --warp north
shift + cmd - h : yabai -m window --warp west
shift + cmd - l : yabai -m window --warp east

## move window to display left and right
# shift + cmd - s : yabai -m window --display west; yabai -m display --focus west;
# shift + cmd - g : yabai -m window --display east; yabai -m display --focus east;

## Change Window Size: yabai --resize edge:dx:dy, through yabai/resize.sh, which stops where an app won't get
## any smaller (Option+right-drag resizes too, see yabairc)
# increase window size
shift + alt - a : sh ~/.config/yabai/resize.sh left -50 0
shift + alt - s : sh ~/.config/yabai/resize.sh bottom 0 50
shift + alt - w : sh ~/.config/yabai/resize.sh top 0 -50
shift + alt - d : sh ~/.config/yabai/resize.sh right 50 0

# decrease window size
ctrl + alt - a : sh ~/.config/yabai/resize.sh left 50 0
ctrl + alt - s : sh ~/.config/yabai/resize.sh bottom 0 -50
ctrl + alt - w : sh ~/.config/yabai/resize.sh top 0 50
ctrl + alt - d : sh ~/.config/yabai/resize.sh right -50 0

# Minimize window (yabai's refocus signal picks the next window)
alt - c : yabai -m window --minimize

# move window to prev and next space
shift + alt - p : yabai -m window --space prev;
shift + alt - n : yabai -m window --space next;

# Move window to space 
# shift + alt - 1 : yabai -m window --space 1; yabai -m space --focus 1
# shift + alt - 2 : yabai -m window --space 2; yabai -m space --focus 2
# shift + alt - 3 : yabai -m window --space 3; yabai -m space --focus 3
# shift + alt - 4 : yabai -m window --space 4; yabai -m space --focus 4
# shift + alt - 5 : yabai -m window --space 5; yabai -m space --focus 5
# shift + alt - 6 : yabai -m window --space 6; yabai -m space --focus 6
shift + alt - 1 : id=$(yabai -m query --windows --window | jq '.id'); yabai -m window --space 1; yabai -m space --focus 1; yabai -m window --focus $id
shift + alt - 2 : id=$(yabai -m query --windows --window | jq '.id'); yabai -m window --space 2; yabai -m space --focus 2; yabai -m window --focus $id
shift + alt - 3 : id=$(yabai -m query --windows --window | jq '.id'); yabai -m window --space 3; yabai -m space --focus 3; yabai -m window --focus $id
shift + alt - 4 : id=$(yabai -m query --windows --window | jq '.id'); yabai -m window --space 4; yabai -m space --focus 4; yabai -m window --focus $id
shift + alt - 5 : id=$(yabai -m query --windows --window | jq '.id'); yabai -m window --space 5; yabai -m space --focus 5; yabai -m window --focus $id
shift + alt - 6 : id=$(yabai -m query --windows --window | jq '.id'); yabai -m window --space 6; yabai -m space --focus 6; yabai -m window --focus $id

# -- Moving Between Spaces --
shift + alt + ctrl - 1 : yabai -m space --focus 1
shift + alt + ctrl - 2 : yabai -m space --focus 2
shift + alt + ctrl - 3 : yabai -m space --focus 3
shift + alt + ctrl - 4 : yabai -m space --focus 4
shift + alt + ctrl - 5 : yabai -m space --focus 5
shift + alt + ctrl - 6 : yabai -m space --focus 6
shift + alt + ctrl - 7 : yabai -m space --focus 7
shift + alt + ctrl - 8 : yabai -m space --focus 8
shift + alt + ctrl - 9 : yabai -m space --focus 9


# Toggle between vertical and horizontal split for an application
alt - x : yabai -m window --toggle split

# Launch script for mpv/japanese
ctrl + cmd - m : ~/scripts/mpv-layout.sh

# Screenshot of the focused window to the clipboard, without its shadow (macOS's own shortcuts are shift+cmd 1-5).
# Replaces apps' "Close Window" on this key.
shift + cmd - w : screencapture -c -o -l "$(yabai -m query --windows --window | jq '.id')"

# -- StartingmStopping/Restarting Yabai --
# x, not q: Karabiner turns Ctrl+Opt+Q into "move tab left" before skhd sees it
ctrl + alt - x : yabai --stop-service
ctrl + alt - r : yabai --restart-service || yabai --start-service   # restart fails once stopped, so start

