# chezmoi:template:left-delimiter="[[" right-delimiter="]]"
# Only settings that differ from kitty's defaults. Full reference for the installed version:
#   kitty +runpy 'from kitty.config import commented_out_default_config; print(commented_out_default_config())' | less

# General settings
# Remote control only over the socket (smart-splits.nvim uses it); text printed in a pane can't drive kitty
allow_remote_control socket-only
listen_on unix:/tmp/kitty

# Background (relative paths resolve against ~/.config/kitty)
background_image background-pics/ghostInTheShellCity4k.jpg
background_image_layout cscaled
background_image_linear yes
background_tint 0.933
background_opacity 1

tab_bar_style powerline
cursor_shape block
cursor_blink_interval 0
hide_window_decorations titlebar-only

# cursor animations
cursor_trail 10
cursor_trail_start_threshold 0
cursor_trail_decay 0.01 0.05

# KITTY THEME
# Catppuccin-Mocha
include current-theme.conf

# Fonts (bold pinned: with this family, auto picks SemiBold)
font_family      family="JetBrainsMono Nerd Font Mono"
bold_font        family="JetBrainsMono Nerd Font Mono" style=Bold
italic_font      auto
bold_italic_font family="JetBrainsMono Nerd Font Mono" style="Bold Italic"
font_size 15.0
map cmd+plus  change_font_size all +0.5
map cmd+minus change_font_size all -0.5
# Ctrl(+Shift) +/- too; kitty's own Ctrl+Shift defaults step 2 points
map ctrl+plus        change_font_size all +0.5
map ctrl+minus       change_font_size all -0.5
map kitty_mod+plus   change_font_size all +0.5
map kitty_mod+equal  change_font_size all +0.5
map kitty_mod+minus  change_font_size all -0.5
# Cmd+0 resets; kitty's own 2-point steps off
map cmd+equal       no_op
map cmd+shift+equal no_op
map cmd+shift+minus no_op

# Scrolling: notched mouse wheels use wheel_scroll_multiplier; trackpads and smooth-scrolling
# mice use touch_scroll_multiplier (default 1.0), lower it only if that feels too fast
wheel_scroll_multiplier 0.2
# touch_scroll_multiplier 0.5
scrollbar scrolled-and-hovered

[[ if eq .chezmoi.os "darwin" -]]
# Right Option sends Alt (Neovim's <M-…> maps, Claude Code's Meta keys); left Option keeps typing [ ] { } | \
macos_option_as_alt right
# kitty's own maps see either Option as Alt, so these letters send Alt from left Option too
# (Snacks picker: p preview, h hidden files, i ignored files, m maximize, r regex)
map alt+p send_text all \x1bp
map alt+h send_text all \x1bh
map alt+i send_text all \x1bi
map alt+m send_text all \x1bm
map alt+r send_text all \x1br

# === Keybinds ===
# Prevent accidental opening of panes
map cmd+enter no_op
map kitty_mod+enter no_op

# Shell commands
map cmd+shift+n send_text all z ~/.config/nvim && nvim \n
map cmd+shift+t send_text all nvim ~/.tmux.conf \n
map cmd+shift+z send_text all nvim ~/.zshrc \n
map cmd+shift+k send_text all nvim ~/.config/kitty/kitty.conf \n
map cmd+shift+y send_text all nvim ~/.config/yabai/yabairc \n
# B for binds
map cmd+shift+b send_text all nvim ~/.config/skhd/skhdrc \n

# Command+arrow keycodes
map cmd+left send_text all \x1b[1;5D
map cmd+right send_text all \x1b[1;5C

# Command+backspace: Ctrl+U (delete to line start in zsh, Neovim insert mode and Claude Code), which tmux passes through
map cmd+backspace send_text all \x15

# Enter keycodes. kitty sends Shift+Enter as plain Enter unless the program asks for kitty's own
# keyboard protocol, which tmux doesn't. tmux (extended-keys on) turns this code into Shift+Enter for
# programs that ask for it (Claude Code: newline) and into plain Enter for the rest.
map shift+enter send_text all \x1b[13;2u

# Command+hjkl keycodes for resizing
map cmd+h send_text all \x1bh
map cmd+j send_text all \x1bj
map cmd+k send_text all \x1bk
map cmd+l send_text all \x1bl

# Command+numbers keycodes
map cmd+1 send_text all \x1b1
map cmd+2 send_text all \x1b2
map cmd+3 send_text all \x1b3
map cmd+4 send_text all \x1b4
map cmd+5 send_text all \x1b5
map cmd+6 send_text all \x1b6
map cmd+7 send_text all \x1b7
map cmd+8 send_text all \x1b8
map cmd+9 send_text all \x1b9
[[ else -]]
# === Keybinds  (keyd turns your Command/Alt key into Ctrl before kitty,
#                so Command+X is bound here as ctrl+X) ===

# Open config files (Command+Shift+letter -> Ctrl+Shift+letter)
map ctrl+shift+n send_text all z ~/.config/nvim && nvim \n
map ctrl+shift+t send_text all nvim ~/.tmux.conf \n
map ctrl+shift+z send_text all nvim ~/.zshrc \n
map ctrl+shift+k send_text all nvim ~/.config/kitty/kitty.conf \n
map ctrl+shift+b send_text all sudoedit /etc/keyd/default.conf \n

# Resize hjkl (Command+hjkl -> plain Alt+hjkl, after the keyd edit above)
map alt+h send_text all \x1bh
map alt+j send_text all \x1bj
map alt+k send_text all \x1bk
map alt+l send_text all \x1bl

# Window/tmux numbers (Command+N -> Ctrl+N)
map ctrl+1 send_text all \x1b1
map ctrl+2 send_text all \x1b2
map ctrl+3 send_text all \x1b3
map ctrl+4 send_text all \x1b4
map ctrl+5 send_text all \x1b5
map ctrl+6 send_text all \x1b6
map ctrl+7 send_text all \x1b7
map ctrl+8 send_text all \x1b8
map ctrl+9 send_text all \x1b9

# Command+arrow -> word jump (nvim)
map alt+left  send_text all \x1b[1;5D
map alt+right send_text all \x1b[1;5C

# Command+backspace -> delete word (nvim)
map alt+backspace send_text all \x1b[8;5u
map ctrl+backspace send_text all \x1b\x7f
[[ end -]]
