    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "verbose": false,
  "autoCompactEnabled": true,
  "inputNeededNotifEnabled": true,
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true
  }
