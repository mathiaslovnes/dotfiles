{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "WebFetch",
      "Bash(git diff:*)",
      "Bash(git --no-pager diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "WebFetch(domain:docs.openwebui.com)",
      "Bash(python3 -c \"import mcp.server; print\\(dir\\(mcp.server\\)\\)\" 2>/dev/null || pip show mcp 2>/dev/null | grep -i version)",
      "WebFetch(domain:github.com)",
      "Bash(curl -s http://localhost:8001/openapi.json)",
      "Read(//Users/mathiaslovnes/Desktop/Screenshots/**)",
      "Bash(curl -s http://localhost:8080/api/v1/tools/)",
      "Bash(python3 -m json.tool)",
      "Bash(npm run:*)",
      "Bash(gh run:*)",
      "Bash(.direnv/python-3.11/bin/python -c \"\nimport deepeval.models as m\nprint\\(dir\\(m\\)\\)\n\" 2>&1)",
      "WebFetch(domain:developer.atlassian.com)",
      "WebFetch(domain:support.atlassian.com)",
      "Bash(ls:*)",
      "WebSearch",
      "Bash(gh issue:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "WebFetch(domain:www.confident-ai.com)",
      "Bash(uv run *)",
      "Bash(gh search *)"
    ],
    "deny": [
      "Read(~/.config/chezmoi/key.txt)",
      "Read(~/.ssh/id_*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "swift-lsp@claude-plugins-official": true,
    "message-timestamps@zoharbabin-claude-tools": true,
    "pyright-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-code-setup@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "skill-creator@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "time-sense@amilexx": true
  },
  "extraKnownMarketplaces": {
    "amilexx": {
      "source": {
        "source": "github",
        "repo": "amilexx/Claude-Time-Sense"
      }
    },
    "zoharbabin-claude-tools": {
      "source": {
        "source": "github",
        "repo": "zoharbabin/claude-code-message-timestamps"
      }
    }
  },
  "feedbackDrafts": "notify",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "never",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "kitty",
  "autoCompactEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },
  "cleanupPeriodDays": 365,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Writing or changing file contents outside /tmp and /private/tmp with shell text tools (sed -i, perl -i, heredocs, echo/printf/cat redirection, tee) instead of the Edit or Write tool, which shows the user a diff. Programs that manage their own files (git, chezmoi, brew, formatters, build tools) are fine."
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [
          { "type": "command", "command": "if [ -n \"$TMUX_PANE\" ]; then printf '\\a' > \"$(tmux display-message -p -t \"$TMUX_PANE\" '#{pane_tty}')\"; fi" }
        ]
      }
    ]
  }
}
