[user]
	name = Mathias Løvnes
	email = mathiaslovnes02@gmail.com

[core]
	excludesfile = ~/.gitignore_global
  # Use nvim as main git editor
  editor = nvim
  pager = diff-so-fancy | less --tabs=4 -RFX
  # Don't flag trailing whitespace or blank lines at EOF (diff colors, diff --check, apply)
  whitespace = -trailing-space

[status]
  # Recursively traverse untracked directories to display all contents
  showUntrackedFiles = all
  # Display submodule rev change summaries in status
  submoduleSummary = true

[commit]
  # Show the staged diff below the message in the editor
  verbose = true

[merge]
  # Show the common ancestor in conflicts, with lines both sides share moved out of the markers
  conflictStyle = zdiff3

[push]
  default = current
  # Set the upstream on the first push of a new branch
  autoSetupRemote = true
  # When pushing, also push tags whose commit-ishs are now reachable upstream
  followTags = true

[pull]
  rebase = true

[rebase]
  # Stash uncommitted changes before a rebase and restore them after
  autoStash = true
  # Move fixup!/squash! commits next to their target in rebase -i
  autoSquash = true

[diff]
  algorithm = histogram
  # Color moved blocks differently from real additions and deletions
  colorMoved = default

[rerere]
  # Remember conflict resolutions and reapply them when the same conflict comes back
  enabled = true
  autoupdate = true

[fetch]
  # Drop remote-tracking branches deleted on the remote
  prune = true

[branch]
  sort = -committerdate

[column]
  ui = auto

[help]
  # Ask before running the closest command to a typo
  autocorrect = prompt

[log]
  # Use abbrev SHAs whenever possible/relevant instead of full 40-chars
  abbrevCommit = true
  # No branch/tag names in git log or reflog (lg passes --decorate)
  decorate = false
  # Automatically --follow when given a single path
  follow = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[url "git@github.com:"]
	# Fetch over HTTPS (works without an SSH key), push over SSH
	pushInsteadOf = https://github.com/

[credential "https://github.com"]
	# Empty helper skips the keychain for github.com; gh supplies its own login
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[hook "strip-claude"]
  # Delete Claude co-author trailers in every repo; runs alongside each repo's own hooks
  event = commit-msg
  command = ~/.config/git/hooks/strip-claude-trailer

[receive]
  fsckObjects = true

[transfer]
  fsckobjects = true

[tag]
  # List tags by version (v1.2 before v1.10) instead of alphabetically
  sort = version:refname

[versionsort]
  # Pre-release tags sort before their release, in this order
  suffix = -pre
  suffix = .pre
  suffix = -beta
  suffix = .beta
  suffix = -rc
  suffix = .rc

[alias]
  # Discard duplicate leading “git” (e.g. “git git status”)
  git = "!git"

  # The basic aliases
  s = status
  cm = commit -m
  cp = cherry-pick

  # Branch related aliases
  br = branch
  co = checkout

  # Delete local branches merged into the current branch, except the current branch, worktree branches, main, master and develop.
  groom = "!git branch --merged | grep -vE '^[*+] |^  (main|master|develop)$' | xargs -r git branch -d"

  # Rebase related aliases
  ri = rebase -i
  rb = "!sh -c \"git rebase -i HEAD~$1\" -"
  rc = rebase --continue
  ra = rebase --abort
  rs = rebase --skip

  # Stash related aliases
  poop = stash pop
  wip = commit -m "WIP" -n

  # Push related aliases
  force = push --force-with-lease

  # Mistake related aliases
  wait = reset HEAD
  undo = reset --soft HEAD^
  amend = commit --amend --no-edit

  # Diff related aliases
  changes = diff --name-status
  # Syntax-aware diff and log with difftastic
  dft = -c diff.external=difft diff
  dlog = -c diff.external=difft log -p --ext-diff
  lg = log --pretty=oneline --abbrev-commit --graph --decorate

  # Alias related aliases
  aliases = ! git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ /
[init]
	defaultBranch = main
