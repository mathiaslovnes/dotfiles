# Oh My Zsh's cache and custom folder inside the .chezmoiexternal.toml download, so the exact
# download doesn't delete them (plugin install guides clone into custom/plugins)
.oh-my-zsh/cache
.oh-my-zsh/cache/**
.oh-my-zsh/custom
.oh-my-zsh/custom/**
# Ignore Karabiner automatic backups
**/karabiner/automatic_backups/**
**/karabiner/private_assets/**
**/karabiner/assets/**
# Ignore macOS metadata files
**/.DS_Store
**/dot_DS_Store
# Ignore backup config files
**/*.bak
**/watch_later/**
**/watch_history.jsonl
**/github_copilot/**
**/jgit/**
**/linearmouse/**
**/__pycache__
# uosc and thumbfast come from their own installers
.config/mpv/scripts/uosc
.config/mpv/scripts/uosc/**
.config/mpv/scripts/thumbfast.lua
.config/mpv/fonts
.config/mpv/fonts/**
# vim-jukit per-machine state
**/.jukit
**/.jukit/**
.local/share/sentence-pitch/sentence_pitch/user_files
.local/share/sentence-pitch/sentence_pitch/__pycache__
.local/share/sentence-pitch/sentence_pitch/meta.json
# Anki add-ons: meta.json holds settings and API keys; user_files and logs are local data
**/addons21/*/meta.json
**/addons21/*/user_files
**/addons21/*/user_files/**
**/addons21/*/*log*.txt

# Linux-only files — don't create these on macOS
{{ if ne .chezmoi.os "linux" }}
.config/keyd/**
{{ end }}

# macOS-only files — don't create these on Linux
{{ if ne .chezmoi.os "darwin" }}
.config/karabiner/**
.config/yabai/**
.config/skhd/**
.config/Brewfile
Library
.local/share/sentence-pitch
.local/bin/anki-icloud-backup
{{ end }}
