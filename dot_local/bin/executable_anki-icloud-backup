#!/usr/bin/env python3
"""
Copies Anki's collection backups and media to iCloud Drive. Runs whenever Anki writes a
backup (every 30 minutes while you use it, and when you close it), at login, and once a day,
via ~/Library/LaunchAgents/com.mathiaslovnes.anki-icloud-backup.plist.
Log: ~/Library/Logs/anki-icloud-backup.log

iCloud Drive/Anki backup/
  collection/anki-collection-YYYY-MM-DD.colpkg   Anki's newest backup of each day, last KEEP_DAYS days,
                                                 plus the first of each month for KEEP_MONTHS months
                                                 (restore: Anki > File > Import)
  media/                                         mirror of collection.media
  media (deleted)/YYYY-MM-DD/                    files that left collection.media (Check Media >
                                                 Delete Unused), kept HOLD_DAYS days, then removed

Documents/日本語/Anki + Yomitan backup/ (iCloud through Desktop & Documents)
  add-ons/add-ons.txt                            your AnkiWeb add-ons: name and code, to reinstall
  add-ons/<code> <name>/meta.json                each one's settings (copy back after reinstalling)
  add-ons/ai_language_explainer_claude/          that add-on whole: it isn't on AnkiWeb
  sentence-pitch/                                its caches (Suzuki-kun's answers, Yomitan lookups)
  yomitan-api/                                   the Yomitan API's files for Brave (NativeMessagingHosts)
  yomitan/                                       Yomitan > Settings > Backup > Export Settings saves here
                                                 (by hand; a notification warns when it's over 30 days old)

Failures post a macOS notification; ~/.zshrc warns when the iCloud copy falls 2 days behind.
"""
import glob
import json
import os
import shutil
import subprocess
import sys
import time
import zipfile

PROFILE = os.path.expanduser("~/Library/Application Support/Anki2/user 1")
DEST = os.path.expanduser("~/Library/Mobile Documents/com~apple~CloudDocs/Anki backup")
EXTRA = os.path.expanduser("~/Documents/日本語/Anki + Yomitan backup")
ADDONS = os.path.expanduser("~/Library/Application Support/Anki2/addons21")
WHOLE_ADDONS = ("ai_language_explainer_claude",)  # not on AnkiWeb: keep the whole folder
SENTENCE_PITCH = os.path.expanduser("~/.local/share/sentence-pitch/sentence_pitch/user_files")
YOMITAN_API = os.path.expanduser("~/Library/Application Support/BraveSoftware/Brave-Browser/NativeMessagingHosts")
YOMITAN = os.path.join(EXTRA, "yomitan")
YOMITAN_WARNED = os.path.expanduser("~/Library/Logs/anki-icloud-backup.yomitan-warned")
KEEP_DAYS = 30
KEEP_MONTHS = 12
HOLD_DAYS = 30  # 0: deleted media disappears from iCloud at the next run


def log(msg):
    print(time.strftime("%Y-%m-%d %H:%M:%S"), msg, flush=True)


def notify(msg):
    script = f'display notification {json.dumps(msg, ensure_ascii=False)} with title "Anki backup"'
    subprocess.run(["osascript", "-e", script], check=False)


def copy(src, dst):
    shutil.copy2(src, dst + ".part")
    os.replace(dst + ".part", dst)


def collection():
    bdir = os.path.join(PROFILE, "backups")
    backups = sorted(f for f in os.listdir(bdir) if f.startswith("backup-") and f.endswith(".colpkg"))
    if not backups:
        return
    out = os.path.join(DEST, "collection")
    os.makedirs(out, exist_ok=True)
    newest = os.path.join(bdir, backups[-1])
    size = -1
    for _ in range(20):  # Anki may still be writing it: wait until its size stops changing
        now = os.path.getsize(newest)
        if now == size:
            break
        size = now
        time.sleep(3)
    day = time.strftime("%Y-%m-%d", time.localtime(os.path.getmtime(newest)))
    target = os.path.join(out, f"anki-collection-{day}.colpkg")
    if not os.path.exists(target) or os.path.getmtime(target) < os.path.getmtime(newest):
        try:  # a broken backup (Anki crashed mid-write, full disk) must not replace a good copy
            with zipfile.ZipFile(newest) as z:
                bad = z.testzip()
        except (zipfile.BadZipFile, OSError) as e:
            bad = repr(e)
        if bad:
            log(f"collection: {backups[-1]} failed the zip test ({bad}), kept the existing copy")
            notify(f"Anki backup {backups[-1]} is damaged; the iCloud copy was not replaced")
        else:
            copy(newest, target)
            log(f"collection: {backups[-1]} -> {os.path.basename(target)}")
    mine = sorted(f for f in os.listdir(out) if f.startswith("anki-collection-") and f.endswith(".colpkg"))
    monthly = {}
    for f in mine:
        monthly.setdefault(f[16:23], f)  # first copy of each YYYY-MM
    keep = set(mine[-KEEP_DAYS:]) | set(sorted(monthly.values())[-KEEP_MONTHS:])
    for f in mine:
        if f not in keep:
            os.remove(os.path.join(out, f))
            log(f"collection: removed {f}")


def media():
    src = os.path.join(PROFILE, "collection.media")
    have = {e.name: e for e in os.scandir(src) if e.is_file()}
    if not have:
        log("media: collection.media is empty or missing, nothing done")
        return
    out = os.path.join(DEST, "media")
    os.makedirs(out, exist_ok=True)
    copied = 0
    for name, e in have.items():
        dst = os.path.join(out, name)
        st = e.stat()
        try:
            d = os.stat(dst)
            if d.st_size == st.st_size and int(d.st_mtime) == int(st.st_mtime):
                continue
        except FileNotFoundError:
            pass
        copy(e.path, dst)
        copied += 1
    gone = [n for n in os.listdir(out) if n not in have]
    if len(gone) > max(200, len(have) // 20):  # mass loss (restored profile, damaged folder): don't mirror it
        log(f"media: {len(gone)} files missing from collection.media, mirror left untouched")
        notify(f"{len(gone)} media files vanished from Anki; iCloud mirror not changed")
        gone = []
    if gone:
        hold = os.path.join(DEST, "media (deleted)", time.strftime("%Y-%m-%d"))
        os.makedirs(hold, exist_ok=True)
        for n in gone:
            p = os.path.join(out, n)
            if n.endswith(".part") or not HOLD_DAYS:
                os.remove(p)
            else:
                shutil.move(p, os.path.join(hold, n))
    hroot = os.path.join(DEST, "media (deleted)")
    for d in os.listdir(hroot) if os.path.isdir(hroot) else []:
        try:
            age = time.time() - time.mktime(time.strptime(d, "%Y-%m-%d"))
        except ValueError:
            continue
        if age > HOLD_DAYS * 86400:
            shutil.rmtree(os.path.join(hroot, d))
            log(f"media: removed deleted files from {d}")
    log(f"media: {len(have)} files, {copied} copied, {len(gone)} no longer in Anki")


def copy_if_changed(src, dst):
    try:
        d, s = os.stat(dst), os.stat(src)
        if d.st_size == s.st_size and int(d.st_mtime) == int(s.st_mtime):
            return False
    except FileNotFoundError:
        pass
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    copy(src, dst)
    return True


def safe(name):
    return "".join("_" if c in '/\\:*?"<>|' else c for c in name).strip() or "_"


def extras():
    """Add-on settings, the sentence-pitch caches and the Yomitan API, to Documents/日本語."""
    n, listing = 0, []
    for d in sorted(os.listdir(ADDONS)):
        meta = os.path.join(ADDONS, d, "meta.json")
        if d in WHOLE_ADDONS:
            for root, dirs, files in os.walk(os.path.join(ADDONS, d)):
                dirs[:] = [x for x in dirs if x != "__pycache__"]
                for f in files:
                    if f.endswith(("_log.txt", ".pyc")):
                        continue
                    src = os.path.join(root, f)
                    n += copy_if_changed(src, os.path.join(EXTRA, "add-ons", os.path.relpath(src, ADDONS)))
            continue
        if not d.isdigit() or not os.path.isfile(meta):
            continue  # the add-ons in your dotfiles (sentence_pitch, note_type_export)
        try:
            name = json.load(open(meta, encoding="utf-8")).get("name") or d
        except (OSError, ValueError):
            name = d
        listing.append(f"{d}  {name}")
        n += copy_if_changed(meta, os.path.join(EXTRA, "add-ons", safe(f"{d} {name}"), "meta.json"))
    text = ("Reinstall: Anki > Tools > Add-ons > Get Add-ons..., paste the codes (space-separated).\n"
            "Then copy each meta.json back into its add-on folder (Tools > Add-ons > View Files) and restart Anki.\n\n"
            + "\n".join(listing) + "\n\nAll codes: " + " ".join(x.split()[0] for x in listing) + "\n")
    out = os.path.join(EXTRA, "add-ons", "add-ons.txt")
    if not os.path.exists(out) or open(out, encoding="utf-8").read() != text:
        os.makedirs(os.path.dirname(out), exist_ok=True)
        with open(out + ".part", "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(out + ".part", out)
        n += 1
    for f in sorted(os.listdir(SENTENCE_PITCH)) if os.path.isdir(SENTENCE_PITCH) else []:
        src = os.path.join(SENTENCE_PITCH, f)
        if f.endswith((".json", ".txt")) and os.path.isfile(src):
            n += copy_if_changed(src, os.path.join(EXTRA, "sentence-pitch", f))
    for f in ("yomitan_api.json", "yomitan_api.py"):
        src = os.path.join(YOMITAN_API, f)
        if os.path.isfile(src):
            n += copy_if_changed(src, os.path.join(EXTRA, "yomitan-api", f))
    if n:
        log(f"extras: {n} files updated in {EXTRA}")
    # Yomitan's settings live only in Brave: nag (at most daily) when the manual export goes stale
    ys = sorted(glob.glob(os.path.join(YOMITAN, "yomitan-settings-*.json")), key=os.path.getmtime)
    stale = not ys or time.time() - os.path.getmtime(ys[-1]) > 30 * 86400
    if stale and (not os.path.exists(YOMITAN_WARNED) or time.time() - os.path.getmtime(YOMITAN_WARNED) > 86400):
        log("extras: Yomitan settings export is missing or older than 30 days")
        notify("Yomitan settings export is stale: Settings > Backup > Export Settings")
        open(YOMITAN_WARNED, "w").close()


def main():
    if not os.path.isdir(PROFILE):
        log(f"no Anki profile at {PROFILE}")
        return 1
    if not os.path.isdir(os.path.dirname(DEST)):
        log("iCloud Drive not found")
        return 1
    collection()
    media()
    try:
        extras()
    except Exception as e:  # never keep the collection and media from being backed up
        log(f"extras: {e!r}")
        notify(f"Backup extras failed: {e!r}")
    return 0


if __name__ == "__main__":
    try:
        rc = main()
    except Exception as e:
        log(f"failed: {e!r}")
        notify(f"Backup failed: {e!r}")
        raise
    if rc:
        notify("Backup did not run, see ~/Library/Logs/anki-icloud-backup.log")
    sys.exit(rc)
