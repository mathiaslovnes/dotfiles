#!/bin/zsh -f
# new files in folders chezmoi manages whole; custom Anki add-ons are the non-numeric folders
chezmoi unmanaged ~/.config/{nvim,kitty,mpv,sketchybar,yabai,skhd,karabiner,fastfetch} \
  ~/.claude/agents ~/.ipython/profile_default/startup ~/scripts ~/.local/share/sentence-pitch/sentence_pitch \
  ~/Library/Application\ Support/Anki2/addons21/[^0-9]*(/N)
