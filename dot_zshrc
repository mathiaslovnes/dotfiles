# === zsh-vi-mode ===
function zvm_after_init() {
  # Re-apply any other bindings zsh-vi-mode clobbers
  # Disable Ctrl+P and Ctrl+N (history navigation) in insert mode
  bindkey -M viins '^N' menu-select
  bindkey -M viins '^P' reverse-menu-select

  # fzf rebinds (needs to be here since zsh-vi-mode overwrites these too)
  bindkey -M viins '^F' fzf-file-widget # Search [F]iles
  bindkey -M viins '^R' fzf-history-widget # History / [R]ecall
  bindkey -M viins '^Z' fzf-cd-widget # Fzf directories - [Z]oxide mnemonic

  # Restore normal backspace (zsh-vi-mode overrides this)
  bindkey -M viins '^?' backward-delete-char
  bindkey -M viins '^H' backward-delete-char

  # Add sudo to the current or previous command by hitting ESC-ESC
  bindkey -M viins '^s' sudo-command-line

  # Option+left/right: backward/forward word
  bindkey -M viins "^[[1;3D" backward-word
  bindkey -M viins "^[[1;3C" forward-word

  # Command+left/right: jump to line start/end
  bindkey -M viins "^[[1;5D" beginning-of-line
  bindkey -M viins "^[[1;5C" end-of-line

  # Command+backspace: delete entire line
  bindkey "^[[8;5u" kill-whole-line

  # Shift/option+backspace: remove word
  bindkey "^[^?" backward-kill-word

  # Prevent appending semicolon to zsh-autocomplete
  zstyle ':autocomplete:*' append-semicolon no

  # Need to source this last for zsh-vi-mode to work - no idea why
  bindkey -M viins '^N' menu-select
  bindkey -M viins '^P' reverse-menu-select
  source /opt/homebrew/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh
  # bindkey -M viins '^I' menu-select
  # bindkey -M menuselect '^I' menu-complete
  # bindkey -M menuselect "$terminfo[kcbt]" reverse-menu-complete
}

# === FZF ===
# Exclude certain directories from fzf
export FZF_ALT_C_COMMAND="fd --type d --hidden --exclude .git --exclude Library --exclude .direnv --exclude node_modules --exclude .jukit"
export FZF_DEFAULT_COMMAND="fd --type f --hidden --exclude .git --exclude Library --exclude .direnv --exclude node_modules"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# === ZSH-AUTOCOMPLETE ===
# Prevent appending semicolon to zsh-autocomplete
zstyle ':autocomplete:*' append-semicolon no
zstyle ':completion:*' completer _complete
# accept searches not only matching prefixes
zstyle ':completion:*' matcher-list \
    'm:{[:lower:]}={[:upper:]}' \
    '+r:|[._-]=* r:|=*' \
    '+l:|=*'
autoload -Uz compinit && compinit
source /opt/homebrew/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh

