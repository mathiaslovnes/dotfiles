# -------------------------
# Environment variables and PATH
# -------------------------
typeset -U path PATH fpath FPATH  # drop repeated entries, so nested shells don't pile up PATH
export EDITOR="nvim"
export VISUAL="nvim"
if [[ "$OSTYPE" == darwin* ]]; then
  export PATH="/opt/homebrew/opt/postgresql@18/bin:$PATH"
fi
# MPLBACKEND (kitty inline plots) is set per prompt by _mpl_kitty_backend at the bottom
export MPLCONFIGDIR="$HOME/.matplotlib"
# manual: show figures at their own size (figure.figsize in ~/.matplotlib/matplotlibrc) instead of
# resizing them to the terminal, so text is the same size as in jukit's saved output history
export MPLBACKEND_KITTY_SIZING=manual

# -------------------------
# Oh My Zsh setup
# -------------------------
export ZSH="$HOME/.oh-my-zsh"
# fzf and direnv are set up at the bottom (after zsh-vi-mode), not through their Oh My Zsh plugins
plugins=(sudo alias-finder)
zstyle ':omz:update' mode disabled  # chezmoi refreshes Oh My Zsh weekly (.chezmoiexternal.toml)

source $ZSH/oh-my-zsh.sh

# -------------------------
# Plugins
# -------------------------
# Homebrew on macOS (Brewfile), copies chezmoi downloads into ~/.zsh on Linux (.chezmoiexternal.toml)
if [[ "$OSTYPE" == darwin* ]]; then
  zsh_plugins=/opt/homebrew/share
else
  zsh_plugins=~/.zsh
fi

# === zsh-vi-mode ===
# set up while sourcing instead of at the first prompt, where it overwrote the bindings made below
ZVM_INIT_MODE=sourcing
ZVM_SYSTEM_CLIPBOARD_ENABLED=true  # y/d/c also copy to the system clipboard
source $zsh_plugins/zsh-vi-mode/zsh-vi-mode.plugin.zsh

source $zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source $zsh_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_CLEAR_WIDGETS+=(zvm_accept_line zvm_vi_cmd_mode)
source $zsh_plugins/zsh-autocomplete/zsh-autocomplete.plugin.zsh

# === Key bindings (viins is zsh-vi-mode's insert mode) ===
# Ctrl+N/P: completion menu instead of history
bindkey -M viins '^N' menu-select
bindkey -M viins '^P' reverse-menu-select

# fzf widgets (defined by `fzf --zsh` at the bottom)
bindkey -M viins '^F' fzf-file-widget # Search [F]iles
bindkey -M viins '^R' fzf-history-widget # History / [R]ecall
bindkey -M viins '^Z' fzf-cd-widget # Fzf directories - [Z]oxide mnemonic

# Restore normal backspace (zsh-vi-mode overrides this)
bindkey -M viins '^?' backward-delete-char
bindkey -M viins '^H' backward-delete-char

# Ctrl+S: add sudo to the current or previous command
bindkey -M viins '^s' sudo-command-line

# Option+left/right: backward/forward word
bindkey -M viins "^[[1;3D" backward-word
bindkey -M viins "^[[1;3C" forward-word

# Command+up/down (Ctrl+Home/End from kitty): first/last line of a multi-line command
buffer-start() { CURSOR=0 }
buffer-end() {
  CURSOR=$#BUFFER
  [[ $KEYMAP == vicmd && $CURSOR -gt 0 ]] && CURSOR=$(( CURSOR - 1 ))   # normal mode stays on the last character
  return 0
}
zle -N buffer-start
zle -N buffer-end
bindkey -M viins "^[[1;5H" buffer-start
bindkey -M viins "^[[1;5F" buffer-end
bindkey -M vicmd "^[[1;5H" buffer-start
bindkey -M vicmd "^[[1;5F" buffer-end

# Option+backspace: delete word
bindkey -M viins '^[^?' backward-kill-word

# Command+backspace (kitty sends Ctrl+U): delete to the start of the line
bindkey -M viins '^U' backward-kill-line

