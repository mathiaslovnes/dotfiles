# kitty plot backend only when the python3 on PATH has it installed; elsewhere matplotlib would fail
# to import it at the first figure. Added after direnv's hook, so it sees the folder's venv
_mpl_kitty_backend() {
  local -a hit=( ${commands[python3]:h:h}/lib/python3*/site-packages/matplotlib-backend-kitty(N) )
  if (( $#hit )); then
    export MPLBACKEND='module://matplotlib-backend-kitty'
  else
    unset MPLBACKEND
  fi
}
precmd_functions+=(_mpl_kitty_backend)

