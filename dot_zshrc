# Fix: clear ghost autosuggestion text after tab completion
typeset -g _pd_fix_last_buf=""
_fix_stale_postdisplay() {
  if [[ -n "$POSTDISPLAY" ]]; then
    local len_diff=$(( ${#BUFFER} - ${#_pd_fix_last_buf} ))
    if (( len_diff > 1 || len_diff < 0 )); then
      unset POSTDISPLAY
    fi
  fi
  _pd_fix_last_buf="$BUFFER"
}
